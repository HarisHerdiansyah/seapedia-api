meta {
  name: Register (NON_ADMIN)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/authentication/register
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "testuser01",
    "email": "testuser01@example.com",
    "password": "Password1!",
    "role": "NON_ADMIN"
  }
}

tests {
  test("Status is 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });

  test("data contains id, username, email, role", function() {
    const data = res.getBody().data;
    expect(data).to.have.property("id");
    expect(data.username).to.equal("testuser01");
    expect(data.email).to.equal("testuser01@example.com");
    expect(data.role).to.equal("NON_ADMIN");
  });
}
