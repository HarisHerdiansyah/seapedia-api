meta {
  name: [Negative] Select Role — NON_ADMIN Ambil ADMIN
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/authentication/non-admin-role
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "activeRole": "ADMIN"
  }
}

tests {
  test("Status is 403 Forbidden", function() {
    expect(res.getStatus()).to.equal(403);
  });

  test("success is false", function() {
    expect(res.getBody().success).to.equal(false);
  });

  test("message mentions non-admin restriction", function() {
    expect(res.getBody().message).to.include("Non-admin users");
  });
}
