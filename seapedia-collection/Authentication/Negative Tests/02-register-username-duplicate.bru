meta {
  name: [Negative] Register — Username Duplicate
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/authentication/register
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "testuser01",
    "email": "berbeda99@example.com",
    "password": "Password1!",
    "role": "NON_ADMIN"
  }
}

tests {
  test("Status is 409 Conflict", function() {
    expect(res.getStatus()).to.equal(409);
  });

  test("success is false", function() {
    expect(res.getBody().success).to.equal(false);
  });
}
