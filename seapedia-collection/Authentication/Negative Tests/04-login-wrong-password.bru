meta {
  name: [Negative] Login — Wrong Password
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/authentication/login
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "testuser01@example.com",
    "password": "WrongPass1!"
  }
}

tests {
  test("Status is 401 Unauthorized", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("success is false", function() {
    expect(res.getBody().success).to.equal(false);
  });
}
