meta {
  name: [Negative] Reset Password — Email Not Found
  type: http
  seq: 9
}

patch {
  url: {{base_url}}/api/authentication/reset-password
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "tidakada@example.com",
    "newPassword": "NewPass1!"
  }
}

tests {
  test("Status is 404 Not Found", function() {
    expect(res.getStatus()).to.equal(404);
  });

  test("success is false", function() {
    expect(res.getBody().success).to.equal(false);
  });

  test("message mentions email not found", function() {
    expect(res.getBody().message).to.include("not found");
  });
}
