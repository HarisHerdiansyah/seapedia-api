meta {
  name: [Negative] Register — Validation Failed (Weak Password)
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/authentication/register
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "newuser99",
    "email": "newuser99@example.com",
    "password": "password1",
    "role": "NON_ADMIN"
  }
}

tests {
  test("Status is 400 Bad Request", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("success is false", function() {
    expect(res.getBody().success).to.equal(false);
  });

  test("message mentions password requirement", function() {
    expect(res.getBody().message).to.include("uppercase");
  });
}
