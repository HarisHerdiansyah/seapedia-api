meta {
  name: [Negative] Refresh Token — No Cookie (Missing Session)
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/authentication/refresh-token
  body: none
}

tests {
  test("Status is 403 Forbidden", function() {
    expect(res.getStatus()).to.equal(403);
  });

  test("success is false", function() {
    expect(res.getBody().success).to.equal(false);
  });

  test("message is Refresh token is missing", function() {
    expect(res.getBody().message).to.equal("Refresh token is missing.");
  });
}
