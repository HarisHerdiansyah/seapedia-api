meta {
  name: [Negative] Invalid Token
  type: http
  seq: 10
}

post {
  url: {{base_url}}/api/authentication/non-admin-role
  body: json
}

headers {
  Content-Type: application/json
  Cookie: refreshToken=ini.token.palsu.tidak.valid
}

body:json {
  {
    "activeRole": "BUYER"
  }
}

tests {
  test("Status is 401 Unauthorized", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("success is false", function() {
    expect(res.getBody().success).to.equal(false);
  });

  test("message is Invalid or expired token", function() {
    expect(res.getBody().message).to.equal("Invalid or expired token.");
  });
}
