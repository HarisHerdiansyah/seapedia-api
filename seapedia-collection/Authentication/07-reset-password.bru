meta {
  name: Reset Password
  type: http
  seq: 7
}

patch {
  url: {{base_url}}/api/authentication/reset-password
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "testuser01@example.com",
    "newPassword": "NewPass1!"
  }
}

tests {
  test("Status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });

  test("message is correct", function() {
    expect(res.getBody().message).to.equal("Password reset successful.");
  });
}
