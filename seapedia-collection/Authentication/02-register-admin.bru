meta {
  name: Register (ADMIN)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/authentication/register
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "adminuser01",
    "email": "admin01@example.com",
    "password": "AdminPass1!",
    "role": "ADMIN"
  }
}

tests {
  test("Status is 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });

  test("role is ADMIN", function() {
    expect(res.getBody().data.role).to.equal("ADMIN");
  });
}
