meta {
  name: Refresh Token
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/authentication/refresh-token
  body: none
}

script:post-response {
  if (res.getStatus() === 200) {
    const token = res.getBody().data.accessToken;
    bru.setVar("access_token", token);
  }
}

tests {
  test("Status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("New accessToken is present", function() {
    expect(res.getBody().data.accessToken).to.be.a("string").and.not.empty;
  });

  test("Set-Cookie contains new refreshToken", function() {
    const setCookie = res.getHeaders()["set-cookie"];
    expect(setCookie).to.include("refreshToken");
  });

  test("message is correct", function() {
    expect(res.getBody().message).to.equal("Token refreshed successfully.");
  });
}
