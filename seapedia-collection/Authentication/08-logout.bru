meta {
  name: Logout
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/authentication/logout
  body: none
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("access_token", "");
  }
}

tests {
  test("Status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });

  test("Set-Cookie clears refreshToken (Max-Age=0)", function() {
    const setCookie = res.getHeaders()["set-cookie"];
    expect(setCookie).to.include("Max-Age=0");
  });
}
