meta {
  name: Select Active Role — NON_ADMIN → BUYER
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/authentication/non-admin-role
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "activeRole": "BUYER"
  }
}

tests {
  test("Status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });

  test("message is correct", function() {
    expect(res.getBody().message).to.equal("Active role updated successfully.");
  });
}
